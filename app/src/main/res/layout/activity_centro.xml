<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/MD_Theme_Primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".CentroActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:background="@drawable/recuardo3"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >

            <Space
                android:layout_width="30dp"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/textView8"
                android:layout_width="195dp"
                android:layout_height="match_parent"
                android:text="Centros de reciclaje locales"
                android:textAlignment="center"
                android:textColor="@color/MD_Theme_On_Primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="30dp"
                android:layout_height="match_parent"/>

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                app:srcCompat="@drawable/centror" />

            <Space
                android:layout_width="30dp"
                android:layout_height="match_parent"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="35dp"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCentros"
        android:layout_width="360dp"
        android:layout_height="400dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/recuadro"
        android:padding="8dp"
        tools:listitem="@android:layout/simple_list_item_2"
        />

    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresarC"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="135dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:text="Regresar"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/MD_Theme_PrimaryContainer"
            app:cornerRadius="16dp"
            android:onClick="abrirMenu"
            />

    </LinearLayout>

</LinearLayout>